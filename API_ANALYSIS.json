          "items": [
            {
              "id": "uuid",
              "orderId": "uuid",
              "serviceItemId": "uuid",
              "quantity": "integer",
              "unitPrice": "decimal",
              "subtotal": "decimal",
              "serviceItem": {
                "id": "uuid",
                "name": "string",
                "price": "decimal",
                "service": {
                  "id": "uuid",
                  "name": "string"
                }
              }
            }
          ],
          "user": {
            "id": "uuid",
            "name": "string",
            "phone": "string"
          },
          "driver": {
            "id": "uuid",
            "name": "string",
            "phone": "string",
            "vehicleNumber": "string"
          },
          "address": "Address object",
          "rating": {
            "rating": "number (1-5)",
            "comment": "string",
