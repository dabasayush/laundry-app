          },
          "createdAt": "ISO datetime",
          "updatedAt": "ISO datetime"
        },
        "mobile_uses": true,
        "admin_uses": true
      },
      {
        "method": "PATCH",
        "path": "/api/v1/orders/:id/status",
        "description": "Update order status (admin/driver only, validates transitions)",
        "auth": "Bearer JWT (ADMIN | DRIVER)",
        "request": {
          "status": "OrderStatus enum",
          "driverId": "uuid (optional, assign driver when PICKUP_ASSIGNED)"
        },
        "response": "Updated Order object",
        "transitions": {
          "PENDING": ["PICKUP_ASSIGNED", "CANCELLED"],
          "PICKUP_ASSIGNED": ["PICKED_UP", "CANCELLED"],
          "PICKED_UP": ["PROCESSING"],
          "PROCESSING": ["OUT_FOR_DELIVERY"],
          "OUT_FOR_DELIVERY": ["DELIVERED"],
          "DELIVERED": [],
          "CANCELLED": []
        },
        "mobile_uses": false,
        "admin_uses": true
      },
      {
        "method": "PATCH",
        "path": "/api/v1/orders/:id/pickup",
        "description": "Change pickup address while order is PENDING",
        "auth": "Bearer JWT (CUSTOMER)",
        "request": {
          "addressId": "uuid"
        },
        "response": "Updated Order object",
        "mobile_uses": false,
        "admin_uses": false
      },
      {
        "method": "POST",
        "path": "/api/v1/orders/:id/items",
        "description": "Add more items to PENDING order (clears existing discount)",
        "auth": "Bearer JWT (CUSTOMER)",
        "request": {
          "items": [
            {
              "serviceItemId": "uuid",
              "quantity": "integer (1-100)"
            }
          ]
        },
        "response": "Updated Order object",
        "mobile_uses": false,
        "admin_uses": false
      },
      {
        "method": "POST",
        "path": "/api/v1/orders/:id/cancel",
        "description": "Cancel order (PENDING or PICKUP_ASSIGNED only)",
        "auth": "Bearer JWT (CUSTOMER | ADMIN)",
        "request": {
          "cancellationReason": "CUSTOMER_REQUEST | OUT_OF_STOCK | DRIVER_UNAVAILABLE | TECHNICAL_ISSUE | OTHER (optional)"
        },
        "response": "Updated Order object with CANCELLED status",
        "mobile_uses": true,
        "admin_uses": true
      },
      {
        "method": "PATCH",
        "path": "/api/v1/orders/:id/collect-payment",
        "description": "Mark cash/UPI payment as collected (driver only)",
        "auth": "Bearer JWT (DRIVER)",
        "response": "Updated Order object with COLLECTED paymentStatus",
        "mobile_uses": false,
        "admin_uses": false
      },
      {
        "method": "PATCH",
        "path": "/api/v1/orders/batch-status",
        "description": "Update multiple order statuses (admin/driver only)",
        "auth": "Bearer JWT (ADMIN | DRIVER)",
        "request": {
          "orderIds": ["uuid"],
          "status": "OrderStatus enum",
          "driverId": "uuid (optional)"
        },
        "response": {
          "updated": "number",
          "failed": [
            {
              "orderId": "uuid",
              "reason": "string"
            }
          ]
        },
        "mobile_uses": false,
        "admin_uses": true
      }
