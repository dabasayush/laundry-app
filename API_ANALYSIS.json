        "response": {
          "id": "uuid",
          "userId": "uuid",
          "driverId": "uuid (null initially)",
          "addressId": "uuid",
          "offerId": "uuid (if coupon applied)",
          "totalAmount": "decimal",
          "discountAmount": "decimal (auto-applied best offer or manual)",
          "finalAmount": "decimal",
          "paymentMethod": "CASH | UPI",
          "paymentStatus": "PENDING | COLLECTED | SETTLED",
          "status": "PENDING",
